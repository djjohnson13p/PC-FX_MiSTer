# Socket samples: the CPU's strobes reach them within one SDRAM clock, so the
# retimer must not pull the scheduler's decode in front of them.
set_instance_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF -to "emu:emu|pcfx_memory:pcfx_memory|s_*"
